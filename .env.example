# Copy this file to .env and fill in your real values.
# Do not commit .env to version control.

NVIDIA_API_KEY=your_nvidia_api_key_here
# Optional: force a specific model name available in your NVIDIA account.
# Example: meta/llama-4-maverick-17b-128e-instruct
NVIDIA_MODEL=

# Legacy aliases still supported by the app provider.
# Prefer NVIDIA_API_KEY / NVIDIA_MODEL in new setups.
# GEMINI_API_KEY=
# GEMINI_MODEL=
